#!/usr/bin/env python3
"""Un singur instantaneu Things 3 pentru widget-ul din bară.

Panoul nu vorbește el cu Things Cloud și nu pornește zece procese ca să-și
umple cele opt vederi: rulează scriptul ăsta, care întreabă CLI-ul `things3`
și scrie *un* JSON cu tot ce-i trebuie panoului — task-urile, apartenența lor
la vederi, proiectele cu progres, ariile, etichetele și numărătorile.

De ce merită un helper și nu opt `Process` în QML:

  * Sincronizarea costă. `things3 <vedere>` face un sync cu norul la fiecare
    rulare (~700 ms); `things3 --no-sync <vedere>` citește cache-ul local în
    ~4 ms. Deci se face **un** sync, apoi toate celelalte întrebări merg pe
    cache. Opt procese pornite din QML ar fi făcut opt sincronizări.

  * Apartenența la vederi e a CLI-ului, nu a noastră. „Today" nu înseamnă
    `scheduled_at == azi` — înseamnă și restanțele, și serile, și instanțele
    recurente de azi. Regula aia trăiește în `things3 today`; o reimplementare
    în JS ar diverge tăcut. Așa că vederile dau *listele de id-uri*, iar
    detaliul fiecărui task vine dintr-un singur `find --any-status`.

  * O eroare de rețea nu trebuie să golească panoul. Dacă sincronizarea pică,
    instantaneul se compune oricum din cache și duce eroarea cu el, ca panoul
    să poată arăta datele vechi cu un semn că sunt vechi.

Ieșire: JSON pe stdout, întotdeauna un obiect, întotdeauna cu `ok`. Erorile
nu se scriu pe stderr ca să moară în jurnal — intră în JSON, fiindcă singurul
lor cititor e panoul.
"""

import argparse
import calendar
import json
import re
import os
import selectors
import subprocess
import sys
import time
from datetime import date, datetime, timedelta, timezone

CLI = "things3"

# Sincronizarea are voie să dureze (rețea); citirile din cache, nu. Dacă o
# citire locală nu răspunde în două secunde, ceva e rupt și e mai bine să
# raportăm decât să lăsăm panoul să aștepte.
SYNC_TIMEOUT = 25
READ_TIMEOUT = 10

# Cât are voie să scrie un `things3`, și cât au voie toate la un loc.
#
# Ieșirea CLI-ului nu e de încredere doar fiindcă vine de pe disc: un jurnal
# Things corupt, un `find` intrat în buclă sau un binar `things3` înlocuit pot
# scoate oricâți octeți — iar instantaneul îi ține pe toți în memorie de trei
# ori: o dată aici, o dată în JSON-ul parsat, o dată în colectorul din QML.
# Deci se taie în două locuri. Fiecare proces are plafonul lui, ca unul singur
# scăpat de sub control să nu ducă nicăieri; și toate au împreună un buget, ca
# zece răspunsuri fiecare cuminte să nu se adune peste ce încape. Un
# instantaneu real, cu mii de task-uri, stă sub un megaoctet.
MAX_OCTETI_PROCES = 8 * 1024 * 1024
MAX_OCTETI_INSTANTANEU = 32 * 1024 * 1024
# Din stderr ne trebuie doar primul rând, pentru mesaj.
MAX_OCTETI_STDERR = 64 * 1024
# Și ce scriem noi are plafon: peste el, panoul primește o eroare scurtă, nu
# un șir care i-ar umple colectorul.
MAX_OCTETI_IESIRE = 16 * 1024 * 1024
BUCATA = 64 * 1024


class CliError(Exception):
    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind
        self.message = message


class Buget:
    """Octeții pe care îi mai are de cheltuit un instantaneu, cu totul.

    Trăiește cât o compunere de instantaneu și trece prin toate apelurile ei,
    ca al zecelea `things3` să știe cât au lăsat primele nouă.
    """

    def __init__(self, total=MAX_OCTETI_INSTANTANEU):
        self.ramas = max(0, int(total))

    def plafon(self):
        """Cât are voie să scrie următorul proces: ce-i mai mic dintre plafonul
        lui și ce-a mai rămas din buget."""
        return min(MAX_OCTETI_PROCES, self.ramas)

    def scade(self, octeti):
        self.ramas = max(0, self.ramas - octeti)


def _incheie(proc):
    """Omoară procesul și îi închide țevile — nimic nu rămâne în urmă."""
    if proc.poll() is None:
        try:
            proc.kill()
        except OSError:
            pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    for teava in (proc.stdout, proc.stderr):
        if teava is not None:
            try:
                teava.close()
            except OSError:
                pass


def _aduna(proc, timeout, plafon, eticheta):
    """Citește stdout și stderr pe măsură ce vin, cu tăiere la depășire.

    `subprocess.run(capture_output=True)` înghițea orice, oricât: tot ce scria
    CLI-ul intra în memorie și abia pe urmă se putea vedea cât e — adică prea
    târziu. Aici se citește în bucăți și se numără pe drum, iar prima bucată
    care trece de plafon oprește totul: procesul e omorât înainte ca ieșirea
    lui să ajungă în `json.loads`, și cu atât mai puțin în colectorul din QML.

    Pentru ceas se ține un termen absolut, fiindcă timpul se consumă și între
    bucăți, nu doar într-o singură așteptare.
    """
    iesire = bytearray()
    erori = bytearray()
    termen = time.monotonic() + timeout

    selector = selectors.DefaultSelector()
    selector.register(proc.stdout, selectors.EVENT_READ, iesire)
    selector.register(proc.stderr, selectors.EVENT_READ, erori)
    try:
        while selector.get_map():
            ramas = termen - time.monotonic()
            if ramas <= 0:
                raise CliError("timeout", "things3 %s a depășit timpul" % eticheta)
            gata = selector.select(timeout=ramas)
            if not gata:
                raise CliError("timeout", "things3 %s a depășit timpul" % eticheta)
            for cheie, _ in gata:
                bucata = os.read(cheie.fd, BUCATA)
                if not bucata:
                    selector.unregister(cheie.fileobj)
                    continue
                if cheie.data is iesire:
                    if len(iesire) + len(bucata) > plafon:
                        raise CliError(
                            "oversize",
                            "things3 %s a scris peste limita de %d octeți"
                            % (eticheta, plafon),
                        )
                    iesire += bucata
                elif len(erori) < MAX_OCTETI_STDERR:
                    erori += bucata[:MAX_OCTETI_STDERR - len(erori)]
    finally:
        selector.close()

    try:
        cod = proc.wait(timeout=max(0.0, termen - time.monotonic()))
    except subprocess.TimeoutExpired:
        raise CliError("timeout", "things3 %s a depășit timpul" % eticheta)
    return cod, bytes(iesire), bytes(erori)


def run(args, timeout, sync=False, buget=None):
    """Rulează `things3` și întoarce textul de pe stdout.

    `--no-sync` e opțiune *globală*, deci stă înaintea subcomenzii — pusă
    după, clap o respinge ca argument necunoscut al subcomenzii.

    Ieșirea se citește în flux și se taie la plafon; fără un buget primit de
    afară, apelul își face unul al lui, ca nici o rulare singuratică să nu
    rămână nemărginită.
    """
    argv = [CLI] + ([] if sync else ["--no-sync"]) + list(args)
    eticheta = " ".join(args[:1])
    if buget is None:
        buget = Buget()
    try:
        proc = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            # Fără moștenirea unui stdin de terminal: helperul rulează dintr-un
            # proces grafic și nu are ce citi de la tastatură.
            stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        raise CliError("missing", "things3 nu este instalat")

    try:
        cod, iesire, erori = _aduna(proc, timeout, buget.plafon(), eticheta)
    finally:
        _incheie(proc)
    buget.scade(len(iesire))

    text = iesire.decode("utf-8", "replace")
    if cod != 0:
        err = erori.decode("utf-8", "replace").strip() or text.strip()
        kind = "auth" if "auth" in err.lower() or "credential" in err.lower() else "cli"
        raise CliError(kind, err.splitlines()[0] if err else "things3 a eșuat")

    return text


def run_json(args, timeout, sync=False, default=None, buget=None):
    raw = run(args, timeout, sync=sync, buget=buget).strip()
    if not raw:
        return default if default is not None else []
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        raise CliError("cli", "things3 %s a răspuns cu ceva ce nu e JSON" % " ".join(args[:1]))


# --------------------------------------------------------------- normalizare

_ISO = re.compile(
    r"^(\d{4})-(\d{2})-(\d{2})"
    r"[T ](\d{2}):(\d{2}):(\d{2})"
    r"(?:\.(\d+))?"
    r"(Z|[+-]\d{2}:?\d{2})?$"
)


def _moment(text):
    """Timestamp-ul Things ca datetime, sau None dacă nu se poate citi.

    `datetime.fromisoformat` nu ia nanosecundele pe care le scrie CLI-ul
    („...02.031327963+00:00"), de aceea se parsează cu regex.
    """
    m = _ISO.match(str(text or "").strip())
    if not m:
        return None
    an, luna, zi, ora, minut, secunda = (int(m.group(i)) for i in range(1, 7))
    fus = m.group(8)
    if fus in (None, ""):
        return datetime(an, luna, zi, ora, minut, secunda)
    if fus == "Z":
        decalaj = timedelta(0)
    else:
        semn = 1 if fus[0] == "+" else -1
        corp = fus[1:].replace(":", "")
        decalaj = timedelta(hours=int(corp[:2]), minutes=int(corp[2:4])) * semn
    return datetime(an, luna, zi, ora, minut, secunda, tzinfo=timezone(decalaj))


def _local(dt):
    """Momentul în ora locală, ca datetime fără fus."""
    if dt.tzinfo is None:
        return dt
    return dt.astimezone().replace(tzinfo=None)


def zi_moment(stamp):
    """Ziua în care s-a petrecut un moment real — creat, modificat, bifat.

    Aici nu se rotunjește nimic: un task bifat la 23:40 a fost bifat în ziua
    aia, nu în următoarea.
    """
    if not stamp:
        return None
    dt = _moment(stamp)
    if dt is None:
        return str(stamp)[:10] or None
    return _local(dt).date().isoformat()


def zi_reper(stamp):
    """Ziua calendaristică a unui *reper* — programarea și termenul.

    Câmpurile astea nu sunt momente, sunt zile; Things le codează însă ca
    timestamp-uri, și în două forme diferite:

      `--when today`       -> 2026-09-10T00:00:00+00:00   (miezul nopții UTC)
      `--when 2026-09-11`  -> 2026-09-10T21:00:00+00:00   (miezul nopții local)

    Prima e o zi „plutitoare" și se ia ca atare — convertită în ora locală ar
    aluneca cu o zi pentru oricine e destul de departe de UTC.

    A doua se citește în ora locală, dar **rotunjită** la cel mai apropiat
    miez de noapte, nu trunchiată. Motivul e o eroare a CLI-ului: el aplică
    decalajul de *azi* datei-țintă, așa că o dată de peste trecerea la ora de
    iarnă iese cu o oră pe lângă — `--when 2026-11-15`, cerut vara, ajunge
    `2026-11-14T21:00:00+00:00`, adică 23:00 pe 14 în ora locală. Trunchiat,
    task-ul apărea cu o zi mai devreme; rotunjit, cade unde a fost cerut.
    O oră lipsă nu poate muta rezultatul, fiindcă un reper stă întotdeauna
    lângă un miez de noapte, niciodată la mijlocul zilei.
    """
    if not stamp:
        return None
    dt = _moment(stamp)
    if dt is None:
        return str(stamp)[:10] or None

    if dt.tzinfo is not None and dt.utcoffset() == timedelta(0) \
            and (dt.hour, dt.minute, dt.second) == (0, 0, 0):
        return dt.date().isoformat()

    loc = _local(dt)
    zi = loc.date()
    if loc.hour >= 12:
        zi = zi + timedelta(days=1)
    return zi.isoformat()


def ref(obj):
    """Referință compactă {id, title} pentru proiect / arie / titlu de secțiune."""
    if not isinstance(obj, dict):
        return None
    ident = obj.get("id")
    if not ident:
        return None
    return {"id": ident, "title": obj.get("title") or ""}


# Unitățile de recurență ale lui Things, așa cum apar în `rule.fu`. Valorile
# de aici sunt cele **verificate pe date reale**, comparând regula cu zilele
# instanțelor pe care le-a produs:
#
#   fu=16,  fa=5, pași de exact 5 zile           -> „la 5 zile"
#   fu=256, fa=1, pași de 7 zile, toate miercuri -> „săptămânal"
#   fu=8,   fa=1, pași de ~31 zile, ziua 9       -> „lunar"
#
# `fu=4` nu se putea verifica la fel — un task anual n-are un al doilea
# exemplar din care să-i măsori pasul. Things are însă exact patru unități
# (zi / săptămână / lună / an), trei erau deja fixate de datele de mai sus,
# deci a rămas una singură; iar autorul task-ului a confirmat că e anual.
#
# O valoare `fu` în afara tabelului iese ca „se repetă", fără să inventeze o
# cadență pe care apoi omul s-ar baza.
UNITATI_RECURENTA = {
    16: "day",
    256: "week",
    8: "month",
    4: "year",
}


def decodeaza_recurenta(rule):
    """Regula brută a lui Things, redusă la unitate + interval."""
    if not isinstance(rule, dict):
        return None
    unitate = UNITATI_RECURENTA.get(rule.get("fu"))
    interval = rule.get("fa")
    if not isinstance(interval, int) or interval < 1:
        interval = 1
    return {"unit": unitate or "", "interval": interval, "raw": rule.get("fu")}


# Things nu scrie „fără termen" ca null, ci ca o dată imposibil de atins:
# `4001-01-01`. Netradusă, santinela ar ieși în panou ca o insignă de termen
# în anul 4001 — se vede doar pe șabloanele recurente, fiindcă numai ele
# ajung aici cu câmpul pus.
ANUL_FARA_TERMEN = 4000


def termen(stamp):
    zi = zi_reper(stamp)
    if zi and zi[:4].isdigit() and int(zi[:4]) >= ANUL_FARA_TERMEN:
        return None
    return zi


# ------------------------------------------------------- ocurențe proiectate
#
# Un task recurent din Things e două lucruri: un *șablon* (invizibil, fără dată,
# purtătorul regulii) și *instanțele* materializate din el. CLI-ul nu pune
# șabloanele în nicio vedere, iar instanțele apar abia în preajma zilei lor —
# așa că nu se vedea nimic recurent, deși regula e cunoscută.
#
# Aici se calculează ocurențele următoare din regulă și se adaugă în vederile
# după zi: cea de azi în „Today", restul în „Upcoming". Sunt rânduri
# *proiectate*: se văd, dar nu se pot bifa ori edita, fiindcă până nu le
# materializează Things n-au un id pe care CLI-ul să-l accepte.
#
# Ancora nu e `rule.ia` (pe un șablon îl găsești și cu ia = epoca zero), ci
# ultima instanță materializată — data care s-a verificat deja pe teren. Se
# cade pe `ia`, apoi pe `sr`, doar pentru șabloanele care n-au produs încă nimic.

ORIZONT_PROIECTII = 365
PROIECTII_PE_SABLON = 6

# Câți pași are voie să facă generatorul până să iasă din trecut. Un șablon
# zilnic abandonat acum trei ani are nevoie de ~1100; peste zece mii nu mai e
# o recurență, e o regulă stricată, și e mai bine să renunțăm decât să rotim.
PASI_MAXIMI = 10000


def _epoca_zi(secunde):
    """Un timestamp din regulă ca dată, sau None dacă e evident o umplutură.

    Things scrie în `ia` epoca zero pentru regulile care n-au ancoră reală, iar
    în `sr` chiar și anul 1; nici una nu e o zi din care să pornești.
    """
    if not isinstance(secunde, (int, float)) or secunde <= 0:
        return None
    try:
        zi = datetime.fromtimestamp(secunde, timezone.utc).date()
    except (OverflowError, OSError, ValueError):
        return None
    if zi.year < 1990 or zi.year >= ANUL_FARA_TERMEN:
        return None
    return zi


def zi_din_iso(text):
    """„YYYY-MM-DD" înapoi ca dată — drumul invers al lui zi_reper."""
    try:
        an, luna, zi = (int(x) for x in str(text).split("-"))
        return date(an, luna, zi)
    except (TypeError, ValueError):
        return None


def _adauga_luni(zi, luni):
    """Aceeași zi a lunii, `luni` luni mai încolo, ciuntită la lunile scurte."""
    total = zi.year * 12 + (zi.month - 1) + luni
    an, luna = divmod(total, 12)
    return date(an, luna + 1, min(zi.day, calendar.monthrange(an, luna + 1)[1]))


def _pas(ancora, unitate, interval, k):
    """A k-a ocurență după ancoră.

    Se numără *din ancoră*, nu din ocurența precedentă: altfel un „lunar, pe 31"
    ar aluneca definitiv pe 28 după prima trecere prin februarie.
    """
    if unitate == "day":
        return ancora + timedelta(days=interval * k)
    if unitate == "week":
        return ancora + timedelta(days=7 * interval * k)
    if unitate == "month":
        return _adauga_luni(ancora, interval * k)
    if unitate == "year":
        return _adauga_luni(ancora, 12 * interval * k)
    return None


def proiecteaza(tasks, azi, orizont=ORIZONT_PROIECTII, maxim=PROIECTII_PE_SABLON):
    """Ocurențele viitoare ale șabloanelor recurente, ca task-uri proiectate."""
    sabloane = {t["id"]: t for t in tasks.values()
                if t["template"] and not t["trashed"] and t["repeat"]}
    if not sabloane:
        return []

    # Zilele deja materializate, ca să nu dublăm o instanță pe care Things a
    # creat-o între timp, și ultima dintre ele, care devine ancoră.
    ocupate = {}
    ultima = {}
    for task in tasks.values():
        parinte = task["templateId"]
        if not parinte or parinte not in sabloane or not task["when"]:
            continue
        ocupate.setdefault(parinte, set()).add(task["when"])
        if task["when"] > ultima.get(parinte, ""):
            ultima[parinte] = task["when"]

    stamp = azi.isoformat()
    limita = date.fromordinal(azi.toordinal() + orizont)
    proiectii = []

    for ident, sablon in sabloane.items():
        regula = sablon["repeat"] or {}
        unitate = regula.get("unit") or ""
        interval = regula.get("interval") or 1
        if unitate not in ("day", "week", "month", "year"):
            continue

        brut = (sablon.get("_rule") or {})
        ancora = None
        if ident in ultima:
            ancora = zi_din_iso(ultima[ident])
        if ancora is None:
            ancora = _epoca_zi(brut.get("ia")) or _epoca_zi(brut.get("sr"))
        if ancora is None:
            continue

        zile = ocupate.get(ident, set())
        gasite = 0
        for k in range(0, PASI_MAXIMI + 1):
            zi = _pas(ancora, unitate, interval, k)
            if zi is None or zi > limita:
                break
            iso = zi.isoformat()
            # Trecutul rămâne al CLI-ului: o ocurență veche pe care Things n-a
            # materializat-o n-a fost niciodată un task real, deci n-are ce
            # căuta printre restanțe. Ziua de azi intră însă — dacă instanța de
            # azi încă n-a apărut, treaba tot azi e de făcut.
            if iso < stamp or iso in zile:
                continue
            proiectii.append(ocurenta(sablon, iso))
            gasite += 1
            if gasite >= maxim:
                break

    proiectii.sort(key=lambda t: (t["when"], t["title"]))
    return proiectii


def ocurenta(sablon, iso):
    """Șablonul, copiat ca task-ul pe care Things îl va crea în ziua aceea."""
    task = dict(sablon)
    # Id-ul nu e al unui obiect din Things, deci nu trebuie să semene cu unul:
    # prefixul îl ține departe de orice comandă a CLI-ului, iar panoul îl
    # folosește doar ca să deosebească rândurile între ele.
    task["id"] = "projected:%s:%s" % (sablon["id"], iso)
    task["sid"] = ""
    task["when"] = iso
    task["bucket"] = "scheduled"
    task["status"] = "incomplete"
    task["template"] = False
    task["templateId"] = sablon["id"]
    task["recurring"] = True
    task["projected"] = True
    task["completed"] = None
    # Termenul unui șablon e o dată fixă; copiat pe fiecare ocurență, ar pune
    # același deadline (de obicei deja trecut) pe toate. Things îl recalculează
    # la materializare, deci aici e mai cinstit să lipsească.
    task["deadline"] = None
    # Checklist-ul șablonului se copiază în instanță abia la materializare, cu
    # id-uri noi; arătat aici, ar fi o listă pe care n-o poate bifa nimeni.
    task["checklist"] = []
    task.pop("_rule", None)
    return task


def normalize(task):
    """Task-ul CLI-ului, redus la ce desenează panoul.

    Panoul primește sute de task-uri prin proprietăți QML; forma completă a
    CLI-ului (obiecte imbricate pentru start / dates / recurrence / flags /
    indexes) ar traversa granița aia la fiecare reîmprospătare fără ca nimic
    să o citească. Plată și scurtă, se copiază ieftin.
    """
    start = task.get("start") or {}
    dates = task.get("dates") or {}
    rec = task.get("recurrence") or {}
    idx = task.get("indexes") or {}

    checklist = []
    for item in task.get("checklist") or []:
        checklist.append({
            "id": item.get("id") or "",
            "sid": item.get("short_id") or "",
            "title": item.get("title") or "",
            "status": item.get("status") or "incomplete",
            "done": item.get("status") == "completed",
            "index": item.get("index") or 0,
        })
    checklist.sort(key=lambda c: c["index"])

    return {
        "id": task.get("id") or "",
        "sid": task.get("short_id") or "",
        "title": task.get("title") or "",
        "notes": task.get("notes") or "",
        "status": task.get("status") or "incomplete",
        "type": task.get("type") or "todo",
        "bucket": start.get("bucket") or "anytime",
        # Reper de zi vs. moment real — vezi zi_reper / zi_moment.
        "when": zi_reper(start.get("scheduled_at")),
        "evening": bool(start.get("evening")),
        "deadline": termen(dates.get("deadline_at")),
        "created": zi_moment(dates.get("created_at")),
        "modified": zi_moment(dates.get("modified_at")),
        "completed": zi_moment(dates.get("completed_at")),
        "project": ref(task.get("project")),
        "area": ref(task.get("area")),
        "heading": ref(task.get("heading")),
        "tags": [t.get("title") or "" for t in (task.get("tags") or []) if isinstance(t, dict)],
        "checklist": checklist,
        "recurring": bool(rec.get("is_instance") or rec.get("is_template")),
        "template": bool(rec.get("is_template")),
        # Instanța nu-și poartă regula, doar id-ul șablonului care a produs-o;
        # regula se lipește mai jos, după ce toate task-urile sunt citite.
        "templateId": (rec.get("template_ids") or [None])[0],
        "repeat": decodeaza_recurenta(rec.get("rule")),
        # Adevărat doar pentru rândurile calculate de proiecteaza(); un task
        # venit de la CLI e întotdeauna real și acționabil.
        "projected": False,
        # Regula brută, păstrată doar pe șabloane și doar până se calculează
        # proiecțiile: `ia` / `sr` sunt ancorele de rezervă ale unui șablon
        # care n-a produs încă nicio instanță. Se scoate înainte de ieșire —
        # panoul citește cadența din `repeat`, nu de aici.
        "_rule": rec.get("rule") if rec.get("is_template") else None,
        "trashed": bool((task.get("flags") or {}).get("trashed")),
        "sort": idx.get("sort_index") or 0,
        "todaySort": idx.get("today_sort_index") or 0,
    }


def ids_of(rows):
    out = []
    for row in rows or []:
        ident = row.get("id")
        if ident:
            out.append(ident)
    return out


# ----------------------------------------------------------------- snapshot

VIEWS = [
    ("today", ["today"]),
    ("upcoming", ["upcoming"]),
    ("anytime", ["anytime"]),
    ("someday", ["someday"]),
    ("inbox", ["inbox"]),
]


def esec(mesaj, fel):
    """Instantaneul pe care îl primește panoul când n-avem ce-i da."""
    return {
        "ok": False,
        "error": mesaj,
        "errorKind": fel,
        "at": int(datetime.now().timestamp()),
        "tasks": {}, "views": {}, "projects": [], "areas": [], "tags": [], "counts": {},
    }


def scrie(data):
    return json.dumps(data, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def snapshot(do_sync=True, logbook_days=14, projection_days=ORIZONT_PROIECTII):
    today = date.today()
    # Un singur buget pentru toate apelurile din instantaneul ăsta: plafonul
    # pe proces n-ar opri zece răspunsuri care, fiecare sub el, se adună peste.
    buget = Buget()
    out = {
        "ok": True,
        "error": "",
        "errorKind": "",
        "syncError": "",
        "at": int(datetime.now().timestamp()),
        "today": today.isoformat(),
        "tasks": {},
        "views": {},
        "projects": [],
        "areas": [],
        "tags": [],
        "counts": {},
    }

    # Un singur sync, și numai el are voie să pice fără să strice tot: o rețea
    # căzută înseamnă date vechi, nu panou gol.
    if do_sync:
        try:
            run(["today", "--json"], SYNC_TIMEOUT, sync=True, buget=buget)
        except CliError as exc:
            if exc.kind in ("missing", "auth"):
                out["ok"] = False
                out["error"] = exc.message
                out["errorKind"] = exc.kind
                return out
            out["syncError"] = exc.message

    try:
        # Tot detaliul, dintr-un singur apel. `find --any-status` întoarce și
        # proiectele (type == "project"), deci progresul lor se calculează de
        # aici, fără un apel pe proiect.
        everything = run_json(["find", "--any-status", "--json"], READ_TIMEOUT,
                              default=[], buget=buget)

        for raw in everything:
            task = normalize(raw)
            if task["id"] and not task["trashed"]:
                out["tasks"][task["id"]] = task

        # Fiecare instanță împrumută regula șablonului ei. Fără pasul ăsta,
        # un task recurent din „Azi" ar ști doar că se repetă, nu și cât de des.
        reguli = {}
        for task in out["tasks"].values():
            if task["template"] and task["repeat"]:
                reguli[task["id"]] = task["repeat"]
        for task in out["tasks"].values():
            if not task["repeat"] and task["templateId"]:
                task["repeat"] = reguli.get(task["templateId"])

        for name, args in VIEWS:
            out["views"][name] = ids_of(
                run_json(args + ["--json"], READ_TIMEOUT, default=[], buget=buget))

        # Logbook-ul e nemărginit; panoul arată o fereastră recentă, iar
        # „terminate azi" se numără din ea.
        since = date.fromordinal(today.toordinal() - max(0, logbook_days))
        logbook = run_json(
            ["logbook", "--from", since.isoformat(), "--json"], READ_TIMEOUT,
            default=[], buget=buget
        )
        for raw in logbook:
            task = normalize(raw)
            # Logbook-ul e singura sursă pentru task-uri care nu mai apar în
            # `find` (nu e cazul azi, dar nici nu costă să fim compleți).
            if task["id"] and not task["trashed"]:
                out["tasks"].setdefault(task["id"], task)
        out["views"]["logbook"] = ids_of(logbook)

        projects = run_json(["projects", "list", "--json"], READ_TIMEOUT,
                            default=[], buget=buget)
        areas = run_json(["areas", "list", "--json"], READ_TIMEOUT, default=[], buget=buget)
        tags = run_json(["tags", "list", "--json"], READ_TIMEOUT, default=[], buget=buget)
    except CliError as exc:
        if exc.kind == "oversize":
            # Ce s-a strâns până la tăiere e și mare, și de nefolosit: se
            # aruncă aici, nu se cară până în colectorul panoului.
            return esec(exc.message, exc.kind)
        # Restul erorilor merg mai departe *cu* ce-am apucat să citim: un
        # `things3 tags` picat nu e un motiv să golim lista de azi.
        out["ok"] = False
        out["error"] = exc.message
        out["errorKind"] = exc.kind
        return out

    # Progresul pe proiect: câte task-uri deschise din câte cu totul. Se
    # numără din dump-ul complet, nu cu un apel pe proiect.
    open_by_project = {}
    total_by_project = {}
    for task in out["tasks"].values():
        if task["type"] != "todo":
            continue
        holder = task["project"]["id"] if task["project"] else None
        if not holder:
            continue
        total_by_project[holder] = total_by_project.get(holder, 0) + 1
        if task["status"] == "incomplete":
            open_by_project[holder] = open_by_project.get(holder, 0) + 1

    for raw in projects:
        proj = normalize(raw)
        pid = proj["id"]
        out["projects"].append({
            "id": pid,
            "sid": proj["sid"],
            "title": proj["title"],
            "notes": proj["notes"],
            "area": proj["area"],
            "tags": proj["tags"],
            "when": proj["when"],
            "bucket": proj["bucket"],
            "deadline": proj["deadline"],
            "open": open_by_project.get(pid, 0),
            "total": total_by_project.get(pid, 0),
            "sort": proj["sort"],
        })

    for raw in areas:
        out["areas"].append({
            "id": raw.get("id") or "",
            "sid": raw.get("short_id") or "",
            "title": raw.get("title") or "",
        })

    for raw in tags:
        out["tags"].append({
            "id": raw.get("id") or "",
            "sid": raw.get("short_id") or "",
            "title": raw.get("title") or "",
        })

    # Ocurențele proiectate intră *după* progresul pe proiect (n-au voie să fie
    # numărate ca muncă reală) și *înainte* de counts, ca insigna din bară să
    # arate exact câte rânduri vede omul în Upcoming.
    azi_iso = today.isoformat()
    for proiectie in proiecteaza(out["tasks"], today, orizont=projection_days):
        out["tasks"][proiectie["id"]] = proiectie
        vedere = "today" if proiectie["when"] == azi_iso else "upcoming"
        out["views"].setdefault(vedere, []).append(proiectie["id"])

    for task in out["tasks"].values():
        task.pop("_rule", None)

    stamp = today.isoformat()
    counts = {name: len(ids) for name, ids in out["views"].items()}
    counts["projects"] = len(out["projects"])
    counts["doneToday"] = sum(
        1 for tid in out["views"].get("logbook", [])
        if (out["tasks"].get(tid) or {}).get("completed") == stamp
    )
    counts["overdue"] = sum(
        1 for task in out["tasks"].values()
        if task["status"] == "incomplete" and task["deadline"] and task["deadline"] < stamp
    )
    out["counts"] = counts
    return out


def main():
    parser = argparse.ArgumentParser(description="Instantaneu Things 3 pentru bara Omarchy")
    parser.add_argument("--no-sync", action="store_true",
                        help="citește doar cache-ul local, fără sincronizare cu norul")
    parser.add_argument("--logbook-days", type=int, default=14,
                        help="câte zile de logbook intră în instantaneu (implicit 14)")
    parser.add_argument("--projection-days", type=int, default=ORIZONT_PROIECTII,
                        help="cât de departe se proiectează recurențele în Upcoming "
                             "(implicit %d zile; 0 le oprește)" % ORIZONT_PROIECTII)
    args = parser.parse_args()

    try:
        data = snapshot(do_sync=not args.no_sync, logbook_days=args.logbook_days,
                        projection_days=args.projection_days)
    except Exception as exc:  # noqa: BLE001 — nimic nu are voie să iasă fără JSON
        data = esec(str(exc) or exc.__class__.__name__, "internal")

    brut = scrie(data)
    if len(brut) > MAX_OCTETI_IESIRE:
        # Plafoanele de dinainte sunt pe ce *citim*; ăsta e pe ce *scriem*,
        # ultimul înainte ca textul să treacă în colectorul panoului.
        brut = scrie(esec("instantaneul Things a ieșit prea mare", "oversize"))

    sys.stdout.buffer.write(brut + b"\n")
    sys.stdout.buffer.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
